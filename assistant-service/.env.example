# PostgreSQL used by the Assistant UI/state. In Render use the database URL
# provided by your PostgreSQL service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utp_assistant

# LLM: use openrouter during development or openai for the final provider.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LLM_MAX_TOKENS=500

# Google
GOOGLE_CALENDAR_ID=primary

# Polling. Limit the initial backlog while still processing newly arrived mail.
GMAIL_POLL_SECONDS=60
GMAIL_MAX_RESULTS=10
GMAIL_QUERY=is:unread in:inbox newer_than:2d
APP_TIMEZONE=America/Lima
